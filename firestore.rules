rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsUserDocument(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shiftExistsAndIsOpen(shiftId) {
      return exists(/databases/$(database)/documents/shifts/$(shiftId))
        && get(/databases/$(database)/documents/shifts/$(shiftId)).data.status != "cancelled";
    }

    function validShift(data) {
      return data.keys().hasAll(["date", "startTime", "endTime", "title", "status"])
        && data.keys().hasOnly(["date", "startTime", "endTime", "title", "description", "status"])
        && data.date is string
        && data.date.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && data.startTime is string
        && data.startTime.matches("^[0-9]{2}:[0-9]{2}$")
        && data.endTime is string
        && data.endTime.matches("^[0-9]{2}:[0-9]{2}$")
        && data.title is string
        && data.title.size() > 0
        && data.status is string
        && data.status.size() > 0
        && (!data.keys().hasAny(["description"]) || data.description is string);
    }

    match /shifts/{shiftId} {
      // The Android client must query with status != "cancelled".
      allow read: if signedIn() && resource.data.status != "cancelled";
      allow create: if isAdmin() && validShift(request.resource.data);
      allow update: if isAdmin() && validShift(request.resource.data);
      allow delete: if isAdmin();

      match /signups/{uid} {
        allow read: if ownsUserDocument(uid);
        allow create: if ownsUserDocument(uid)
          && shiftExistsAndIsOpen(shiftId)
          && request.resource.data.keys().hasOnly(["userId", "shiftId", "createdAt"])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.shiftId == shiftId
          && request.resource.data.createdAt == request.time;
        allow delete: if ownsUserDocument(uid) && shiftExistsAndIsOpen(shiftId);
        allow update: if false;
      }
    }

    match /Users/{uid} {
      allow read: if ownsUserDocument(uid);
      allow create: if ownsUserDocument(uid)
        && request.resource.data.keys().hasOnly(["phoneNumber"])
        && request.resource.data.phoneNumber is string;
      allow update: if ownsUserDocument(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["phoneNumber"])
        && request.resource.data.phoneNumber is string;
      allow delete: if false;
    }
  }
}
