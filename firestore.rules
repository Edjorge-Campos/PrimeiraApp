rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function ownsUserDocument(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function shiftExistsAndIsOpen(shiftId) {
      return exists(/databases/$(database)/documents/turnos/$(shiftId))
        && get(/databases/$(database)/documents/turnos/$(shiftId)).data.Status == "open";
    }

    function validShift(data) {
      return data.keys().hasAll(["DiaDaSemana", "Inicio", "Status"])
        && data.keys().hasOnly(["DiaDaSemana", "Inicio", "Status"])
        && data.DiaDaSemana is int
        && data.DiaDaSemana >= 1
        && data.DiaDaSemana <= 7
        && data.Inicio is string
        && data.Inicio.matches("^[0-9]{2}:[0-9]{2}$")
        && data.Status is string;
    }

    match /turnos/{shiftId} {
      allow read: if signedIn();
      allow create: if isAdmin() && validShift(request.resource.data);
      allow update: if isAdmin() && validShift(request.resource.data);
      allow delete: if isAdmin();

      match /signups/{uid} {
        allow read: if ownsUserDocument(uid);
        allow create: if ownsUserDocument(uid)
          && shiftExistsAndIsOpen(shiftId)
          && request.resource.data.keys().hasOnly(["userId", "shiftId", "createdAt"])
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.shiftId == shiftId
          && request.resource.data.createdAt == request.time;
        allow delete: if ownsUserDocument(uid) && shiftExistsAndIsOpen(shiftId);
        allow update: if false;
      }
    }

    match /Users/{uid} {
      allow read: if ownsUserDocument(uid);
      allow create: if ownsUserDocument(uid)
        && request.resource.data.keys().hasOnly(["phoneNumber"])
        && request.resource.data.phoneNumber is string;
      allow update: if ownsUserDocument(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["phoneNumber"])
        && request.resource.data.phoneNumber is string;
      allow delete: if false;
    }
  }
}
